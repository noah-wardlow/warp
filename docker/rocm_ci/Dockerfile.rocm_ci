# =============================================================================
# BUILD CONTEXT REQUIREMENT
#
# The named context "warp_src" must be the root of the warp source
# repository. Providing it explicitly avoids any ambiguity about what the build
# context should contain.
#
#   docker buildx (local):
#     docker buildx build --build-context warp_src=/path/to/warp \
#         -f docker/rocm_ci/Dockerfile.rocm_ci --target warp_base .
#
#   buildctl (CI entrypoint.sh):
#     buildctl build --local warp_src="${SRC_FOLDER}/warp" \
#         --local dockerfile="${SRC_FOLDER}/warp/docker/rocm_ci/Dockerfile.rocm_ci" ...
# =============================================================================
ARG ROCM_VERSION=7.2
ARG UBUNTU_VERSION=24.04
# -----------------------------------------------------------------------------
# Stage 1 (warp_build): compile the wheel and install it.
#   Source tree is present; dist/*.whl is accessible for the whl_export stage.
# -----------------------------------------------------------------------------
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION}-complete AS warp_build

ARG ROCM_VERSION=7.2
ARG PY_VERSION=3.12
ARG TORCH_VERSION=2.9.1
ARG TORCH_VISION_VERSION=0.24.0
ARG MAMBA_ENV_NAME=base

# Install Ubuntu dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt update \
    && apt install -y \
    git \
    git-lfs \
    libtool \
    libegl1-mesa-dev \
    g++-14 \
    wget \
    sudo \
    curl \
    libstdc++-14-dev \
    libdw1 \
    libdrm-dev \
    ccache \
    && apt clean \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 100 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 100


ENV ROCM_PATH=/opt/rocm
ENV PATH=${ROCM_PATH}/bin:${PATH}
ENV LD_LIBRARY_PATH=${ROCM_PATH}/lib:${LD_LIBRARY_PATH}
ENV HIP_PLATFORM=amd

WORKDIR /root/

ARG HIP_ARCH=gfx942

# warp_src is a named build context — see file header for invocation details.
COPY --from=warp_src . /root/warp/
RUN test -f /root/warp/pyproject.toml && \
    grep -q 'name.*=.*"warp-lang"' /root/warp/pyproject.toml || { \
        echo "ERROR: named context 'warp_src' must be the warp source root." >&2; \
        echo "       Expected pyproject.toml with name = 'warp-lang' at root." >&2; \
        exit 1; \
    }
RUN git config --global --add safe.directory /root/warp

RUN curl -L micro.mamba.pm/install.sh | bash && \
    ~/.local/bin/micromamba run -n ${MAMBA_ENV_NAME} ~/.local/bin/micromamba install python=${PY_VERSION} -c conda-forge --override-channels -y && \
    ~/.local/bin/micromamba run -n ${MAMBA_ENV_NAME} pip install cmake pybind11 build ninja scikit-build-core setuptools-scm numpy pytest pytest-xdist Pillow && \
    ~/.local/bin/micromamba run -n ${MAMBA_ENV_NAME} pip install torch==${TORCH_VERSION} torchvision==${TORCH_VISION_VERSION} -f https://repo.radeon.com/rocm/manylinux/rocm-rel-${ROCM_VERSION}/ && \
    /bin/bash -c "eval \"\$(~/.local/bin/micromamba shell hook --shell bash)\" && \
    micromamba activate ${MAMBA_ENV_NAME} && \
    cd /root/warp/ && \
    git lfs pull && \
    python build_lib.py --hip-arch=${HIP_ARCH} --hipcc-options=\"-Xarch_device -fno-inline\" && \
    python -m build --wheel -C--build-option=-Plinux-x86_64 && \
    pip install dist/warp_lang-*.whl"

#-----------------------------------------------------------------------------
# Stage 2 (warp_base): clean release image shipped to users.
#   Source tree and build artifacts are removed; only the installed package
#   and its runtime dependencies remain.
# -----------------------------------------------------------------------------
FROM warp_build AS warp_base

# ARG must be redeclared in each stage that uses it (Docker multi-stage scoping).
ARG MAMBA_ENV_NAME=base

RUN rm -rf /root/warp/

# Activate the micromamba base env for all shell types:
#   - ENV PATH: covers non-interactive shells (docker exec, entrypoints, scripts)
#   - shell init + bashrc append: covers interactive bash sessions
ENV MAMBA_ROOT_PREFIX=/root/micromamba
ENV CONDA_PREFIX=/root/micromamba
ENV CONDA_DEFAULT_ENV=${MAMBA_ENV_NAME}
ENV PATH=/root/micromamba/bin:${PATH}

RUN /root/.local/bin/micromamba shell init --shell bash --root-prefix /root/micromamba && \
echo "micromamba activate base" >> /root/.bashrc

# -----------------------------------------------------------------------------
# Stage 3 (whl_export): minimal scratch image used only to extract the wheel.
#   Built by CI with --output type=local — never shipped to users.
# -----------------------------------------------------------------------------
FROM scratch AS whl_export
COPY --from=warp_build /root/warp/dist/*.whl /
